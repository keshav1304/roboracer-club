#!/bin/bash
# race: map -> raceline -> localize + pure pursuit, on the physical car.
#
#   race map [slam_toolbox|gmapping|cartographer]   SLAM; drive under RC
#   race save <name>                                save the map being built
#   race editor [--port 8090]                       raceline GUI in the browser
#   race run <name> [--max-speed 0.36] [--min-speed 0.13] ...  AMCL + pure pursuit
#   race foxglove                                   Foxglove bridge on :8765
#   race list                                       maps and which have racelines
#   race stop                                       kill SLAM/AMCL/pursuit, stop the car
#
# See README.md next to this script.

set -eo pipefail
RACING_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export RACING_MAPS_DIR="${RACING_MAPS_DIR:-$HOME/osracer_ws/src/osracer/osracer_slam/maps}"
RACECAR_TOOL="$HOME/ros2_ws/src/neoracer_ros2_driver/scripts/racecar-tool.sh"

ros_env() {
    # Same order as run_circle_pursuit.sh: osracer underlay, neoracer overlay,
    # and the neoracer driver/lakibeam packages first on the prefix path.
    set +u
    source /opt/ros/humble/setup.bash
    source "$HOME/osracer_ws/install/setup.bash"
    source "$HOME/ros2_ws/install/setup.bash"
    export AMENT_PREFIX_PATH="$HOME/ros2_ws/install/neoracer_ros2_driver:$HOME/ros2_ws/install/lakibeam1:${AMENT_PREFIX_PATH}"
}

racecar_fn() {
    # The racecar CLI is a bash function; load it in this shell.
    set +eu
    source "$RACECAR_TOOL"
    racecar "$@"
}

ip_hint() {
    # IPv4 only; skip loopback, docker, and the lidar Ethernet subnet (192.168.8.x).
    hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9.]+$' \
        | grep -v -E '^(127\.|172\.17\.|192\.168\.8\.)' | head -3 | tr '\n' ' '
}

stop_slam() {
    pkill -f "[a]sync_slam_toolbox_node" 2>/dev/null || true
    pkill -f "[o]sracer_slam .*launch.py" 2>/dev/null || true
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    map|mapping)
        echo "Step 1/3: SLAM. Drive the whole track under RC (slowly, close the loop)."
        echo "Watch it in Foxglove (bridge runs at boot): connect to ws://<car-ip>:8765, panel /map."
        echo "When done, in another terminal: race save <name>"
        racecar_fn mapping "${1:-slam_toolbox}" "${@:2}"
        ;;

    save)
        name="${1:?usage: race save <name>}"
        [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "race save: use letters, digits, _ and - only" >&2; exit 2; }
        racecar_fn mapping save "$name"
        echo
        echo "Step 2/3: draw the raceline: race editor   then open http://$(ip_hint | awk '{print $1}'):8090"
        ;;

    editor)
        echo "Step 2/3: raceline editor. Open one of:"
        for ip in $(ip_hint); do echo "  http://$ip:${2:-8090}"; done
        exec python3 "$RACING_DIR/raceline_editor.py" "$@"
        ;;

    run)
        name="${1:?usage: race run <name> [--max-speed S] [--min-speed S] (python3 ~/racing/pure_pursuit.py -h for all)}"
        shift
        [[ -f "$RACING_MAPS_DIR/$name.yaml" ]] || { echo "race run: no map '$name' in $RACING_MAPS_DIR" >&2; exit 2; }
        [[ -f "$RACING_MAPS_DIR/${name}_raceline.csv" ]] || {
            echo "race run: no raceline for '$name'. Draw one first: race editor" >&2; exit 2; }
        ros_env
        if ! systemctl is-active --quiet neoracer-teleop; then
            echo "race run: neoracer-teleop is not running (it provides /scan, /odom and the /drive mux)." >&2
            echo "  start it: racecar service start teleop" >&2
            exit 1
        fi
        # The live mapper and the pursuit node would both publish /map.
        stop_slam
        sleep 1

        PP=""; AMCL=""
        cleanup() {
            if [[ -n "$PP" ]]; then kill -INT "$PP" 2>/dev/null || true; wait "$PP" 2>/dev/null || true; fi
            if [[ -n "$AMCL" ]]; then kill "$AMCL" 2>/dev/null || true; fi
        }
        trap cleanup EXIT

        echo "Step 3/3: localize + pure pursuit on '$name'."
        python3 "$RACING_DIR/pure_pursuit.py" --map "$name" "$@" &
        PP=$!
        sleep 2
        if ! pgrep -f "[n]av2_amcl/amcl" >/dev/null; then
            ros2 run nav2_amcl amcl --ros-args --params-file "$RACING_DIR/amcl.yaml" &
            AMCL=$!
            sleep 2
        else
            echo "(AMCL already running; reusing it. If the map changed, run 'race stop' first.)"
        fi
        # Bring AMCL to active. It can take a few seconds to show up in ROS
        # discovery, and a lifecycle call before then fails, so retry until
        # it reports active. A reused AMCL may already be configured/active.
        set +e
        state=""
        for _ in $(seq 1 20); do
            state="$(timeout 5 ros2 lifecycle get /amcl 2>/dev/null | awk '{print $1}')"
            case "$state" in
                active) break ;;
                unconfigured) timeout 15 ros2 lifecycle set /amcl configure >/dev/null 2>&1 ;;
                inactive) timeout 15 ros2 lifecycle set /amcl activate >/dev/null 2>&1 ;;
            esac
            sleep 1
        done
        set -e
        if [[ "$state" != "active" ]]; then
            echo "race run: AMCL did not become active (state: ${state:-not found})." >&2
            echo "  Try by hand: ros2 lifecycle set /amcl configure && ros2 lifecycle set /amcl activate" >&2
            exit 1
        fi
        echo "AMCL active; waiting for /initialpose."
        echo
        echo "  1. Foxglove (ws://<car-ip>:8765): fixed frame 'map', show /map, /scan, /pursuit/path, /pursuit/markers"
        echo "  2. Publish the car's pose with the 2D pose estimate tool on /initialpose; check /scan lines up with walls"
        echo "  3. Flip SWB down to let it drive. Flip up or Ctrl-C to stop."
        wait "$PP"
        ;;

    stop)
        pkill -INT -f "[r]acing/pure_pursuit.py" 2>/dev/null || true
        pkill -f "[n]av2_amcl/amcl" 2>/dev/null || true
        stop_slam
        ros_env
        ros2 topic pub --once /drive ackermann_msgs/msg/AckermannDriveStamped "{drive: {speed: 0.0, steering_angle: 0.0}}" >/dev/null 2>&1 || true
        echo "Stopped SLAM, AMCL and pure pursuit; sent a zero /drive."
        ;;

    foxglove)
        # Normally already up: neoracer-foxglove.service (systemd --user) starts it at boot.
        if systemctl --user is-active --quiet neoracer-foxglove 2>/dev/null; then
            echo "Foxglove bridge is already running (neoracer-foxglove.service). Connect to:"
            for ip in $(ip_hint); do echo "  ws://$ip:8765"; done
            echo "Restart it with: systemctl --user restart neoracer-foxglove"
        elif ss -ltn 2>/dev/null | grep -q ':8765 '; then
            echo "Something already listens on :8765 (probably a Foxglove bridge). Connect to:"
            for ip in $(ip_hint); do echo "  ws://$ip:8765"; done
        else
            exec "$HOME/bin/neoracer-foxglove.sh"
        fi
        ;;

    list|ls)
        printf "%-20s %-10s %s\n" MAP RACELINE SAVED
        for y in "$RACING_MAPS_DIR"/*.yaml; do
            [[ -e "$y" ]] || continue
            n="$(basename "${y%.yaml}")"
            rl="-"; [[ -f "$RACING_MAPS_DIR/${n}_raceline.csv" ]] && rl="yes"
            printf "%-20s %-10s %s\n" "$n" "$rl" "$(date -r "$y" '+%Y-%m-%d %H:%M')"
        done
        ;;

    help|-h|--help|*)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        [[ "$cmd" =~ ^(help|-h|--help)$ ]] || exit 2
        ;;
esac
